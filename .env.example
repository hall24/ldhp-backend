# Copy to .env for local development. NEVER commit real values.
# Dev/staging/prod values live in Azure Key Vault (one vault per environment;
# Claude/dev tooling uses the separate dev vault only).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Neon Postgres (dev branch). App role: least privilege (read/write data only).
DATABASE_URL=postgres://app_user:REPLACE_ME@REPLACE_ME.neon.tech/ldhp?sslmode=require
# Migration role: owns the schema; used only by `npm run db:migrate`.
DATABASE_MIGRATION_URL=postgres://migrator:REPLACE_ME@REPLACE_ME.neon.tech/ldhp?sslmode=require

# Clerk (DEV instance). Server-side secret only; the publishable key belongs in front ends.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional: PEM public key for networkless JWT verification.
CLERK_JWT_KEY=
# Comma-separated front-end origins allowed in the token's azp claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# MCP spike (dev only, synthetic data). See README.
MCP_ACTOR_CLERK_USER_ID=user_test_staff_a
MCP_ORGANIZATION_ID=0a000000-0000-4000-8000-00000000000a
MCP_AGENT_LABEL=mcp-spike-stdio

# Neon: `neon deploy` / `neon env pull` write DATABASE_URL (pooled, for the app) and
# DATABASE_URL_UNPOOLED (direct, used by db:migrate when DATABASE_MIGRATION_URL is unset)
# into .env.local (or .env if it exists). Both files are git-ignored.
# DATABASE_URL_UNPOOLED=
